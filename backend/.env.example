DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=taskmanagement
SESSION_SECRET=change-me-to-a-long-random-string

# Send the session cookie only over HTTPS. Keep false for local HTTP
# (docker compose); set true only when TLS terminates in front of the app.
COOKIE_SECURE=false

# Session store. This value is for running the API on the host
# (`npm run start:dev`) against the Redis container's published port. Under
# docker compose the API is handed redis://redis:6379 instead — the service
# name. See docker-compose.yml.
REDIS_URL=redis://localhost:6379
